# =============================================================================
# S4_QAS - SimpleMDG Automated Testing Framework
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# =============================================================================
# BASE URL
# =============================================================================
# The base URL of your SimpleMDG application
BASE_URL=https://your-environment.simplemdg.cfapps.region.hana.ondemand.com

# =============================================================================
# REQUESTOR ACCOUNT (Default User)
# =============================================================================
# Used for: Creating CRs, My Request operations
SAP_USER=your-requestor@email.com
SAP_PASS=your-password

# =============================================================================
# ADMIN ACCOUNT
# =============================================================================
# Used for: Process Designer, Template Configuration, Admin Settings
ADMIN_USER=your-admin@email.com
ADMIN_PASS=your-password

# =============================================================================
# APPROVER ACCOUNT
# =============================================================================
# Used for: Approving/Rejecting CRs in My Inbox
APPROVER_USER=your-approver@email.com
APPROVER_PASS=your-password

# =============================================================================
# APPROVER 2 ACCOUNT (Multi-level approval)
# =============================================================================
# Used for: 2nd level approver in multi-approver scenarios
APPROVER2_USER=your-approver2@email.com
APPROVER2_PASS=your-password

# =============================================================================
# STEWARD ACCOUNT
# =============================================================================
# Used for: Activating CRs in Activation tab
STEWARD_USER=your-steward@email.com
STEWARD_PASS=your-password

# =============================================================================
# MULTIPLE PROCESS ACCOUNT (Combined Requestor + Approver + Steward)
# =============================================================================
# Used for: MUL test suite - single user with all 3 roles
MUL_USER=your-multi-role-user@email.com
MUL_PASS=your-password

# =============================================================================
# ATTACHMENT TESTING ACCOUNT
# =============================================================================
# Used for: ATT test suite - attachment operations (falls back to STEWARD_USER)
ATTACH_USER=your-attach-user@email.com
ATTACH_PASS=your-password

# =============================================================================
# COMMENT BOX & LOGO TEST SUITE ACCOUNTS (S4_QAS_MM01_COMMENT_LOGO)
# =============================================================================
# Admin user for configuring templates in Process Designer
COMMENT_ADMIN_USER=your-admin-user
COMMENT_ADMIN_PASS=your-admin-pass
# Approver Level 1 (L1)
COMMENT_APPROVER1_USER=your-l1-approver@email.com
COMMENT_APPROVER1_PASS=your-l1-approver-pass
# Approver Level 2 (L2)
COMMENT_APPROVER2_USER=your-l2-approver@email.com
COMMENT_APPROVER2_PASS=your-l2-approver-pass
# Requestor (creates/submits CRs)
COMMENT_REQUESTOR_USER=your-requestor@email.com
COMMENT_REQUESTOR_PASS=your-requestor-pass
# Steward (activates CRs)
COMMENT_STEWARD_USER=your-steward@email.com
COMMENT_STEWARD_PASS=your-steward-pass

# =============================================================================
# CI/CD SETTINGS
# =============================================================================
# Set to 'true' when running in CI/CD environment (GitHub Actions, etc.)
CI=false
