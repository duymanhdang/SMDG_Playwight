    "srch-sm-10": {
      "description": "[SEARCH MASTER DATA] Reorder Result Fields - Change field index order in Search Result Settings",
      "priority": "HIGH",
      "reason": "Validation - Reorder result fields",
      "templateName": "AUTO_MM01_SEARCH_MD",
      "methodName": "Auto_Search_TC10",
      "methodId": "SRCHTC10",
      "fieldConfigs": [
        { "businessTable": "Product", "fieldName": "product", "controlType": "TEXTBOX" },
        { "businessTable": "ProductDescription", "fieldName": "productDescription", "controlType": "TEXTBOX" }
      ],
      "resultFields": ["productType", "productDescription", "objectID"],
      "reorderFields": [
        { "field": "productDescription", "newIndex": "0" },
        { "field": "product", "newIndex": "1" }
