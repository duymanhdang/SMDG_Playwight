  "testData": {
    "ar-e2e-mm-01": {
      "description": "Smoke: Admin + Main E2E Happy Path for Assignment Rule",
      "priority": "P0",
      "templateName": "AUTO_MM01_ASSIGNMENT_RULE",
      "objectType": "Product",
      "sourceCR": "CR0000023786",
      "adminRules": [
        {
          "sourceSection": "UNITSOFMEASURE",
          "sourceField": "unitSpecificProductLength",
          "targetSection": "UNITSOFMEASURE",
          "targetField": "unitSpecificProductHeight"
        },
        {
          "sourceSection": "UNITSOFMEASURE",
          "sourceField": "unitSpecificProductLength",
          "targetSection": "UNITSOFMEASURE",
          "targetField": "unitSpecificProductWidth"
        }
      ],
      "header": {
        "description": "AR-E2E-MM-01: Smoke E2E Assignment Rule with Copy CR",
        "priority": "High",
        "reason": "New Product",
        "notes": "Automation: Verify assignment rule works end-to-end"
      },
      "expectedStatuses": {
        "afterSubmit": "SUBMITTED",
        "afterApprove": "APPROVED",
        "activationStatus": "ACTIVATED"
      },
      "mainInputValue": "15.000",
      "expectedAssignment": "15.000",
      "unitOfDimension": "CM",
      "stewardMainInputValue": "15,000",
      "notes": "E2E Smoke: Admin configures 2 rules (Length→Height, Length→Width) → Copy CR → Fill header → Verify → Submit → Approve → Activate"
    },

