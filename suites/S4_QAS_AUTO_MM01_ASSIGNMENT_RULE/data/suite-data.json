    "ar-e2e-mm-04": {
      "description": "Main: Rule State ON/OFF Verification (Boundary Testing)",
      "priority": "P1",
      "templateName": "AUTO_MM01_ASSIGNMENT_RULE",
      "objectType": "Product",
      "rule": {
        "sourceSection": "BASICDIMENSION",
        "sourceField": "netWeight",
        "targetSection": "BASICDIMENSION",
        "targetField": "materialVolume",
        "sourceProperty": "current"
      },
      "states": [
        {
          "id": "STATE_ON",
          "initialState": "ON",
          "inputValue": "10",
          "expectAssignment": true,
          "expectedTarget": "10"
        },
        {
          "id": "STATE_OFF",
          "initialState": "OFF",
          "inputValue": "20",
          "expectAssignment": false,
          "expectedTarget": ""
        },
        {
          "id": "STATE_TOGGLE",
          "initialState": "ON",
          "toggleToOff": true,
          "toggleBackToOn": true,
          "inputValue": "30",
          "expectAssignment": true,
          "expectedTarget": "30"
        }
      ],
      "notes": "Boundary: Toggle ON → Main verifies assignment → Toggle OFF → Main verifies no assignment"
    },

